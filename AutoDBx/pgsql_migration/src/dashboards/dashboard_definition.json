    },
    {
      "name": "select_group_key",
      "displayName": "select_group_key",
      "query": "select explode(array(\n  'Job Name',\n  'Task Key',\n  'Result State'\n)) as group_key"
    },
    {
      "name": "select_workspace",
      "displayName": "select_workspace",
      "query": "with\n-- get workspaces from job data\nworkspace_data as (\n  select distinct\n    workspace_id,\n    concat('Workspace ', workspace_id) as workspace_name\n  from system.lakeflow.job_task_run_timeline\n  where period_start_time between :param_start_date and :param_end_date\n),\n-- query\nworkspace_selection as (\n  select\n    workspace_name as workspace\n  from workspace_data\n)\nselect * from workspace_selection",
      "parameters": [
        {"displayName": "param_start_date", "keyword": "param_start_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now-12M/M"}]}}},
        {"displayName": "param_end_date", "keyword": "param_end_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now/d"}]}}}
      ]
    },
    {
      "name": "select_job_name",
      "displayName": "select_job_name",
      "query": "with\n-- get job names from job data, filtered for auto-dbx costing framework\njob_data as (\n  select distinct\n    case \n      when j.name like '%]%' then regexp_replace(j.name, '^(\\\\[[^\\\\]]*\\\\])+', '')\n      else j.name\n    end as job_name\n  from system.lakeflow.job_task_run_timeline jtrt\n  join system.lakeflow.jobs j on jtrt.job_id = j.job_id\n  where jtrt.period_start_time between :param_start_date and :param_end_date\n    and (:param_workspace='<ALL WORKSPACES>' or concat('Workspace ', jtrt.workspace_id) = :param_workspace)\n    and (lower(j.name) like '%redshift%' \n         or lower(j.name) like '%mysql%' \n         or lower(j.name) like '%snowflake%' \n         or lower(j.name) like '%bigquery%' \n         or lower(j.name) like '%postgresql%'\n         or lower(j.name) like '%auto_dbx%'\n         or lower(j.name) like '%autodbx%')\n)\nselect * from job_data",
      "parameters": [
        {"displayName": "param_start_date", "keyword": "param_start_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now-12M/M"}]}}},
        {"displayName": "param_end_date", "keyword": "param_end_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now/d"}]}}},
        {"displayName": "param_workspace", "keyword": "param_workspace", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "<ALL WORKSPACES>"}]}}}
      ]
    },
    {
      "name": "select_rank_key",
      "displayName": "select_rank_key",
      "query": "select explode(array(\n  'job_name',\n  'task_key',\n  'result_state',\n  'workspace_id'\n)) as rank_key",
      "parameters": [
        {"displayName": "param_start_date", "keyword": "param_start_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now-12M/M"}]}}},
        {"displayName": "param_end_date", "keyword": "param_end_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now/d"}]}}},
        {"displayName": "param_workspace", "keyword": "param_workspace", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "<ALL WORKSPACES>"}]}}}
      ]
    },
    {
      "name": "job_cost_total",
      "displayName": "job_cost_total",
      "query": "with\n-- get job cost data with pricing\njob_cost_data as (\n  select\n    coalesce(jtrt.workspace_id, 0) as workspace_id,\n    j.name as job_name,\n    jtrt.task_key,\n    jtrt.period_start_time,\n    jtrt.period_end_time,\n    jtrt.result_state,\n    datediff(minute, jtrt.period_start_time, jtrt.period_end_time) as duration_minutes,\n    coalesce(u.usage_quantity * lp.pricing.default, 0) as cost_usd,\n    date_trunc('QUARTER', jtrt.period_start_time) as cost_quarter,\n    date_trunc('MONTH', jtrt.period_start_time) as cost_month,\n    date_trunc('WEEK', jtrt.period_start_time) as cost_week\n  from system.lakeflow.job_task_run_timeline jtrt\n  join system.lakeflow.jobs j on jtrt.job_id = j.job_id\n  left join system.billing.usage u on \n    jtrt.account_id = u.account_id \n    and jtrt.workspace_id = u.workspace_id\n    and u.usage_start_time < jtrt.period_end_time\n    and u.usage_end_time > jtrt.period_start_time\n    and u.billing_origin_product = 'JOBS'\n  left join system.billing.list_prices lp on \n    u.sku_name = lp.sku_name \n    and u.usage_unit = lp.usage_unit\n    and u.usage_end_time between lp.price_start_time and coalesce(lp.price_end_time, current_date())\n  where jtrt.period_start_time between :param_start_date and :param_end_date\n    and (:param_workspace='<ALL WORKSPACES>' or concat('Workspace ', jtrt.workspace_id) = :param_workspace)\n),\n-- calc total cost\ntotal_cost as (\n  select\n    sum(cost_usd) as cost_usd\n  from job_cost_data\n)\n-- query\nselect\n  concat(\n    'Total job cost (USD): $ ',\n    case\n        when cost_usd >= 1e9 then concat(format_number(cost_usd / 1e9, 2), 'B')\n        when cost_usd >= 1e6 then concat(format_number(cost_usd / 1e6, 2), 'M')\n        when cost_usd >= 1e3 then concat(format_number(cost_usd / 1e3, 2), 'K')\n        else format_number(cost_usd, 2)\n    end\n  ) as total_job_cost_usd\nfrom total_cost",
      "parameters": [
        {"displayName": "param_start_date", "keyword": "param_start_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now-12M/M"}]}}},
        {"displayName": "param_end_date", "keyword": "param_end_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now/d"}]}}},
        {"displayName": "param_workspace", "keyword": "param_workspace", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "<ALL WORKSPACES>"}]}}}
      ]
    },
    {
      "name": "job_cost_overview",
      "displayName": "job_cost_overview",
      "query": "with\n-- get job cost data with pricing\njob_cost_data as (\n  select\n    coalesce(jtrt.workspace_id, 0) as workspace_id,\n    j.name as job_name,\n    jtrt.task_key,\n    jtrt.period_start_time,\n    jtrt.period_end_time,\n    jtrt.result_state,\n    datediff(minute, jtrt.period_start_time, jtrt.period_end_time) as duration_minutes,\n    coalesce(u.usage_quantity * lp.pricing.default, 0) as cost_usd,\n    date_trunc('QUARTER', jtrt.period_start_time) as cost_quarter,\n    date_trunc('MONTH', jtrt.period_start_time) as cost_month,\n    date_trunc('WEEK', jtrt.period_start_time) as cost_week\n  from system.lakeflow.job_task_run_timeline jtrt\n  join system.lakeflow.jobs j on jtrt.job_id = j.job_id\n  left join system.billing.usage u on \n    jtrt.account_id = u.account_id \n    and jtrt.workspace_id = u.workspace_id\n    and u.usage_start_time < jtrt.period_end_time\n    and u.usage_end_time > jtrt.period_start_time\n    and u.billing_origin_product = 'JOBS'\n  left join system.billing.list_prices lp on \n    u.sku_name = lp.sku_name \n    and u.usage_unit = lp.usage_unit\n    and u.usage_end_time between lp.price_start_time and coalesce(lp.price_end_time, current_date())\n  where jtrt.period_start_time between :param_start_date and :param_end_date\n    and (:param_workspace='<ALL WORKSPACES>' or concat('Workspace ', jtrt.workspace_id) = :param_workspace)\n),\n-- eval time_key param\ncost_data_with_time_key as (\n  select\n    case\n      when :param_time_key = 'Quarter' then cost_quarter\n      when :param_time_key = 'Month' then cost_month\n      when :param_time_key = 'Week' then cost_week\n      else date(period_start_time)\n    end as time_key,\n    case\n      when :param_group_key = 'Job Name' then job_name\n      when :param_group_key = 'Task Key' then task_key\n      else result_state\n    end as group_key,\n    cost_usd\n  from job_cost_data\n)\n-- query\nselect\n  time_key, group_key, cost_usd\nfrom cost_data_with_time_key",
      "parameters": [
        {"displayName": "param_start_date", "keyword": "param_start_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now-12M/M"}]}}},
        {"displayName": "param_end_date", "keyword": "param_end_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now/d"}]}}},
        {"displayName": "param_workspace", "keyword": "param_workspace", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "<ALL WORKSPACES>"}]}}},
        {"displayName": "param_time_key", "keyword": "param_time_key", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "Week"}]}}},
        {"displayName": "param_group_key", "keyword": "param_group_key", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "Job Name"}]}}}
      ]
    },
    {
      "name": "job_cost_details_table",
      "displayName": "job_cost_details_table",
      "query": "with\n-- get job cost data with pricing, filtered for auto-dbx costing framework\njob_cost_data as (\n  select\n    coalesce(jtrt.workspace_id, 0) as workspace_id,\n    case \n      when j.name like '%]%' then regexp_replace(j.name, '^(\\\\[[^\\\\]]*\\\\])+', '')\n      else j.name\n    end as job_name,\n    jtrt.task_key,\n    jtrt.period_start_time,\n    jtrt.period_end_time,\n    jtrt.result_state,\n    jtrt.job_run_id,\n    datediff(minute, jtrt.period_start_time, jtrt.period_end_time) as duration_minutes,\n    coalesce(u.usage_quantity * lp.pricing.default, 0) as cost_usd\n  from system.lakeflow.job_task_run_timeline jtrt\n  join system.lakeflow.jobs j on jtrt.job_id = j.job_id\n  left join system.billing.usage u on \n    jtrt.account_id = u.account_id \n    and jtrt.workspace_id = u.workspace_id\n    and u.usage_start_time < jtrt.period_end_time\n    and u.usage_end_time > jtrt.period_start_time\n    and u.billing_origin_product = 'JOBS'\n  left join system.billing.list_prices lp on \n    u.sku_name = lp.sku_name \n    and u.usage_unit = lp.usage_unit\n    and u.usage_end_time between lp.price_start_time and coalesce(lp.price_end_time, current_date())\n  where jtrt.period_start_time between :param_start_date and :param_end_date\n    and (:param_workspace='<ALL WORKSPACES>' or concat('Workspace ', jtrt.workspace_id) = :param_workspace)\n    and (lower(j.name) like '%redshift%' \n         or lower(j.name) like '%mysql%' \n         or lower(j.name) like '%snowflake%' \n         or lower(j.name) like '%bigquery%' \n         or lower(j.name) like '%postgresql%'\n         or lower(j.name) like '%auto_dbx%'\n         or lower(j.name) like '%autodbx%')\n)\nselect\n  job_name,\n  task_key,\n  duration_minutes,\n  sum(cost_usd) as total_task_cost,\n  case \n    when sum(duration_minutes) > 0 then sum(cost_usd) / sum(duration_minutes)\n    else 0 \n  end as cost_per_minute,\n  min(period_start_time) as period_start_time,\n  max(period_end_time) as period_end_time,\n  result_state,\n  job_run_id\nfrom job_cost_data\ngroup by job_name, task_key, duration_minutes, result_state, job_run_id\norder by period_start_time desc, job_name, task_key",
      "parameters": [
        {"displayName": "param_start_date", "keyword": "param_start_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now-12M/M"}]}}},
        {"displayName": "param_end_date", "keyword": "param_end_date", "dataType": "DATE", "defaultSelection": {"values": {"dataType": "DATE", "values": [{"value": "now/d"}]}}},
        {"displayName": "param_workspace", "keyword": "param_workspace", "dataType": "STRING", "defaultSelection": {"values": {"dataType": "STRING", "values": [{"value": "<ALL WORKSPACES>"}]}}}
      ]
    }
  ],
